    function downloadBackup() {
      try {
        const backupObj = {
          app: 'MR_Student_Manager',
          exported_at: new Date().toISOString(),
          students: studentsData,
          treasury: treasuryData
        };
        const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(backupObj, null, 2));
        const downloadAnchor = document.createElement('a');
        const dateTag = new Date().toISOString().split('T')[0];
        downloadAnchor.setAttribute("href", dataStr);
        downloadAnchor.setAttribute("download", `MR_Backup_${dateTag}.json`);
        document.body.appendChild(downloadAnchor);
        downloadAnchor.click();
        downloadAnchor.remove();
        closeSideDrawer();
        showToast('تم تنزيل ملف النسخة الاحتياطية بنجاح ✓');
      } catch (e) {
        showToast('حدث خطأ أثناء تنزيل النسخة', 'error');
      }
    }

    function triggerRestoreBackup() {
      document.getElementById('restoreFileInput').click();
    }

    async function handleRestoreBackup(event) {
      const file = event.target.files[0];
      if (!file) return;

      const reader = new FileReader();
      reader.onload = async (e) => {
        try {
          const parsed = JSON.parse(e.target.result);
          const importedStudents = Array.isArray(parsed) ? parsed : parsed.students;
          if (parsed.treasury) {
            treasuryData = parsed.treasury;
            localStorage.setItem('mr_treasury_records', JSON.stringify(treasuryData));
          }
          
          if (!Array.isArray(importedStudents)) {
            showToast('ملف النسخة الاحتياطية غير صالح!', 'error');
            return;
          }

          if (!confirm(`سيتم استرجاع عدد (${importedStudents.length}) طالب من النسخة الاحتياطية. هل تريد المتابعة؟`)) {
            event.target.value = '';
            return;
          }

          studentsData = importedStudents;
          localStorage.setItem('mr_students_backup', JSON.stringify(studentsData));
          renderStudents();
          closeSideDrawer();

          if (navigator.onLine) {
            const { error } = await supabaseClient.from('students').upsert(studentsData);
            if (error) {
              studentsData.forEach(s => addToOfflineQueue('upsert', s));
              showToast('تم استرجاع البيانات محلياً وفي انتظار المزامنة', 'error');
            } else {
              showToast('تم رفع واسترجاع النسخة الاحتياطية ومزامنتها بالسحاب ✓');
            }
          } else {
            studentsData.forEach(s => addToOfflineQueue('upsert', s));
            showToast('تم استرجاع البيانات أوفلاين (ستُرفع عند عودة النت)', 'error');
          }
        } catch (err) {
          showToast('تعذر قراءة الملف، تأكد من اختيار ملف JSON صحيح', 'error');
        }
        event.target.value = '';
      };
      reader.readAsText(file);
    }

    function hardResetLoginSession() {
