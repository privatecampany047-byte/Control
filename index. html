    function updateConnectionBadge() {
      const statusText = document.getElementById('syncStatusText');
      if (!statusText) return;
      const queue = getOfflineQueue();
      if (navigator.onLine) {
        statusText.innerHTML = `<span class="w-2 h-2 rounded-full bg-emerald-500 inline-block animate-pulse"></span> متصل بالسحاب ${queue.length > 0 ? `(في الانتظار: ${queue.length})` : ''}`;
        statusText.className = "text-[11px] text-emerald-400 flex items-center gap-1";
      } else {
        statusText.innerHTML = `<span class="w-2 h-2 rounded-full bg-amber-500 inline-block"></span> وضع أوفلاين (بدون نت) ${queue.length > 0 ? `- محفوظ: ${queue.length}` : ''}`;
        statusText.className = "text-[11px] text-amber-400 flex items-center gap-1";
      }
    }

    function showToast(message, type = 'success') {
      const toast = document.getElementById('toastNotification');
      toast.textContent = message;
      toast.className = `fixed bottom-5 left-5 z-50 px-4 py-3 rounded-xl shadow-2xl text-xs font-bold flex items-center gap-2 transition-all duration-300 ${
        type === 'error' ? 'bg-amber-900 text-amber-100 border border-amber-700' : 'bg-emerald-900 text-emerald-100 border border-emerald-700'
      }`;
      toast.classList.remove('hidden');
      setTimeout(() => {
        toast.classList.add('hidden');
      }, 4000);
    }

