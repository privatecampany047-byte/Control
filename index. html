<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#0f172a">
  <title>تطبيق MR - إدارة الطلاب والمدفوعات</title>
  <link rel="manifest" href="./manifest.json">
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  <script src="https://unpkg.com/html5-qrcode" type="text/javascript"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg-main: #0f172a;
      --bg-card: #1e293b;
      --border-card: #334155;
      --bg-input: #0f172a;
      --border-input: #475569;
      --text-main: #f8fafc;
      --text-sub: #cbd5e1;
      --text-muted: #94a3b8;
    }

    body.light-mode {
      --bg-main: #f1f5f9;
      --bg-card: #ffffff;
      --border-card: #cbd5e1;
      --bg-input: #f8fafc;
      --border-input: #94a3b8;
      --text-main: #0f172a;
      --text-sub: #334155;
      --text-muted: #64748b;
    }

    body {
      font-family: 'Tajawal', sans-serif;
      background-color: var(--bg-main);
      color: var(--text-main);
      transition: background-color 0.25s ease, color 0.25s ease;
    }

    .gold-gradient {
      background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
    }

    .card-bg {
      background-color: var(--bg-card);
      border: 1px solid var(--border-card);
      transition: background-color 0.25s ease, border-color 0.25s ease;
    }

    .input-style {
      background-color: var(--bg-input);
      border: 1px solid var(--border-input);
      color: var(--text-main);
    }

    .input-style:focus {
      border-color: #f59e0b;
      outline: none;
    }

    body.light-mode .text-white { color: #0f172a !important; }
    body.light-mode .text-slate-100 { color: #1e293b !important; }
    body.light-mode .text-slate-200 { color: #334155 !important; }
    body.light-mode .text-slate-300 { color: #475569 !important; }
    body.light-mode .text-slate-400 { color: #64748b !important; }
    body.light-mode .bg-slate-800 { background-color: #e2e8f0 !important; color: #1e293b !important; }
    body.light-mode .bg-slate-900 { background-color: #f1f5f9 !important; }
    body.light-mode .bg-slate-950\/50 { background-color: #ffffff !important; border: 1px solid #e2e8f0; }
    body.light-mode .border-slate-700,
    body.light-mode .border-slate-800 { border-color: #cbd5e1 !important; }

    ::-webkit-scrollbar { width: 8px; }
    ::-webkit-scrollbar-track { background: var(--bg-main); }
    ::-webkit-scrollbar-thumb { background: #475569; border-radius: 4px; }

    @media print {
      body * { visibility: hidden; }
      #printableArea, #printableArea *, #printCenterModal, #printCenterModal * { visibility: visible; }
      #printableArea, #printCenterModal { position: absolute; left: 0; top: 0; width: 100%; background: white !important; color: black !important; }
      .no-print { display: none !important; }
    }
  </style>
</head>
<body class="min-h-screen flex flex-col justify-between">

  <!-- Toast Notification -->
  <div id="toastNotification" class="fixed bottom-5 left-5 z-50 hidden px-4 py-3 rounded-xl shadow-2xl text-xs font-bold flex items-center gap-2 transition-all duration-300"></div>

  <!-- Hidden Input for Backup Restore -->
  <input type="file" id="restoreFileInput" accept=".json" class="hidden" onchange="handleRestoreBackup(event)">

  <!-- Side Drawer Menu (القائمة الجانبية المحدثة) -->
  <div id="sideDrawerBackdrop" onclick="closeSideDrawer()" class="fixed inset-0 bg-black/60 backdrop-blur-xs z-40 hidden transition-opacity"></div>
  <aside id="sideDrawer" class="fixed top-0 right-0 h-full w-72 card-bg border-l border-slate-700 z-50 transform translate-x-full transition-transform duration-300 flex flex-col justify-between p-5 shadow-2xl">
    <div class="space-y-6">
      <div class="flex items-center justify-between border-b border-slate-700 pb-4">
        <div class="flex items-center gap-2.5">
          <div class="w-9 h-9 gold-gradient rounded-xl flex items-center justify-center text-slate-900 font-bold">
            <i class="fa-solid fa-user-tie"></i>
          </div>
          <div>
            <h3 class="font-bold text-sm text-white" id="drawerTeacherName">منصة MR</h3>
            <span class="text-[11px] text-slate-400">الإعدادات والخزينة اليومية</span>
          </div>
        </div>
        <button onclick="closeSideDrawer()" class="text-slate-400 hover:text-white p-1">
          <i class="fa-solid fa-xmark text-lg"></i>
        </button>
      </div>

      <nav class="space-y-2.5 text-xs">
        <!-- 1. الوضع الليلي -->
        <button onclick="toggleTheme()" class="w-full flex items-center justify-between p-3 rounded-xl bg-slate-800/70 hover:bg-slate-800 border border-slate-700/70 font-bold transition">
          <span class="flex items-center gap-2.5 text-slate-200">
            <i id="themeIcon" class="fa-solid fa-sun text-amber-400 text-sm"></i>
            <span id="themeText">تفعيل الوضع الفاتح</span>
          </span>
          <span class="text-[10px] px-2 py-0.5 rounded bg-slate-900 text-amber-400">تبديل</span>
        </button>

        <!-- 2. دفتر الخزينة والإيرادات اليومية -->
        <button onclick="openTreasuryModal()" class="w-full flex items-center gap-3 p-3 rounded-xl bg-slate-800/70 hover:bg-slate-800 border border-slate-700/70 font-bold text-slate-200 transition">
          <i class="fa-solid fa-vault text-amber-400 text-sm"></i>
          <span>دفتر الخزينة والإيرادات اليومية</span>
        </button>

        <!-- 3. إعدادات بيانات المعلم وكلمة المرور -->
        <button onclick="openTeacherSettingsModal()" class="w-full flex items-center gap-3 p-3 rounded-xl bg-slate-800/70 hover:bg-slate-800 border border-slate-700/70 font-bold text-slate-200 transition">
          <i class="fa-solid fa-user-gear text-indigo-400 text-sm"></i>
          <span>تعديل بيانات المعلم والباسورد</span>
        </button>

        <!-- 4. مركز طباعة كشف الطلاب (PDF Print Center) -->
        <button onclick="openPrintCenterModal()" class="w-full flex items-center gap-3 p-3 rounded-xl bg-slate-800/70 hover:bg-slate-800 border border-slate-700/70 font-bold text-slate-200 transition">
          <i class="fa-solid fa-print text-emerald-400 text-sm"></i>
          <span>طباعة كشف شامل للطلاب (PDF)</span>
        </button>

        <!-- النسخ الاحتياطي -->
        <button onclick="downloadBackup()" class="w-full flex items-center gap-3 p-3 rounded-xl bg-slate-800/70 hover:bg-slate-800 border border-slate-700/70 font-bold text-slate-200 transition">
          <i class="fa-solid fa-download text-sky-400 text-sm"></i>
          <span>تنزيل نسخة احتياطية (Backup)</span>
        </button>

        <button onclick="triggerRestoreBackup()" class="w-full flex items-center gap-3 p-3 rounded-xl bg-slate-800/70 hover:bg-slate-800 border border-slate-700/70 font-bold text-slate-200 transition">
          <i class="fa-solid fa-upload text-purple-400 text-sm"></i>
          <span>رفع نسخة احتياطية (Restore)</span>
        </button>
      </nav>
    </div>

    <div class="border-t border-slate-700 pt-4">
      <button onclick="handleLogout()" class="w-full flex items-center justify-center gap-2 p-3 rounded-xl bg-red-950/60 hover:bg-red-900/80 border border-red-800/60 text-red-300 text-xs font-bold transition">
        <i class="fa-solid fa-right-from-bracket"></i>
        <span>تسجيل الخروج</span>
      </button>
    </div>
  </aside>

  <!-- Application Shell -->
  <div id="app" class="flex-grow flex flex-col">
    <!-- Auth Screen -->
    <div id="authScreen" class="flex-grow flex items-center justify-center p-4">
      <div class="card-bg p-8 rounded-2xl shadow-2xl w-full max-w-md border border-slate-700 relative overflow-hidden">
        <div class="absolute top-0 right-0 w-2 h-full gold-gradient"></div>
        <div class="text-center mb-8">
          <div class="w-20 h-20 gold-gradient rounded-full flex items-center justify-center mx-auto mb-4 shadow-lg">
            <i class="fa-solid fa-graduation-cap text-3xl text-slate-900"></i>
          </div>
          <h1 id="authTitle" class="text-2xl font-bold text-white mb-1">منصة MR</h1>
          <p class="text-slate-400 text-sm">نظام إدارة الطلاب والمدفوعات</p>
        </div>

        <form id="loginForm" onsubmit="handleLogin(event)" class="space-y-4">
          <div>
            <label class="block text-sm font-medium text-slate-300 mb-1">البريد الإلكتروني / اسم المستخدم</label>
            <div class="relative">
              <span class="absolute inset-y-0 right-0 flex items-center pr-3 text-slate-400">
                <i class="fa-solid fa-envelope"></i>
              </span>
              <input type="text" id="loginEmail" required placeholder="mr@gmail.com" class="w-full pr-10 pl-3 py-2.5 rounded-xl input-style text-sm">
            </div>
          </div>

          <div>
            <label class="block text-sm font-medium text-slate-300 mb-1">كلمة المرور</label>
            <div class="relative">
              <span class="absolute inset-y-0 right-0 flex items-center pr-3 text-slate-400">
                <i class="fa-solid fa-lock"></i>
              </span>
              <input type="password" id="loginPassword" required placeholder="••••••••" class="w-full pr-10 pl-3 py-2.5 rounded-xl input-style text-sm">
            </div>
          </div>

          <div id="authError" class="hidden text-red-400 text-xs text-center bg-red-950/50 p-2 rounded-lg border border-red-800">
            بيانات الدخول غير صحيحة، يرجى التأكد وإعادة المحاولة.
          </div>

          <button type="submit" class="w-full py-3 rounded-xl gold-gradient font-bold text-slate-900 hover:opacity-90 transition">
            تسجيل الدخول
          </button>
          
          <button type="button" onclick="hardResetLoginSession()" class="w-full py-2 bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs rounded-xl border border-slate-700 transition flex items-center justify-center gap-1.5 mt-2">
            <i class="fa-solid fa-rotate-right text-amber-400"></i>
            <span>إصلاح وتطهير جلسة الدخول (إذا علق معك)</span>
          </button>
        </form>
      </div>
    </div>

    <!-- Main Dashboard -->
    <div id="dashboardScreen" class="hidden flex-grow flex flex-col">
      <!-- Navbar -->
      <header class="card-bg border-b border-slate-700 sticky top-0 z-30">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
          <div class="flex items-center space-x-3 space-x-reverse">
            <button onclick="openSideDrawer()" title="القائمة والإعدادات" class="bg-slate-800 hover:bg-slate-700 text-slate-200 w-10 h-10 rounded-xl border border-slate-700 flex items-center justify-center transition">
              <i class="fa-solid fa-bars text-base"></i>
            </button>
            <div class="w-10 h-10 gold-gradient rounded-xl flex items-center justify-center text-slate-900 font-bold">
              <i class="fa-solid fa-user-tie"></i>
            </div>
            <div>
              <h2 class="font-bold text-base leading-tight" id="navTeacherBrand">MR</h2>
              <span id="syncStatusText" class="text-[11px] text-emerald-400 flex items-center gap-1">
                <span class="w-2 h-2 rounded-full bg-emerald-500 inline-block animate-pulse"></span> متصل بالسحاب
              </span>
            </div>
          </div>

          <div class="flex items-center space-x-2 space-x-reverse">
            <button onclick="processOfflineQueue(true)" id="syncBtn" title="مزامنة فورية" class="bg-slate-800 hover:bg-slate-700 text-amber-400 px-3 py-2 rounded-xl text-sm border border-slate-700 transition flex items-center space-x-1 space-x-reverse">
              <i class="fa-solid fa-rotate" id="syncIcon"></i>
              <span class="hidden sm:inline">مزامنة</span>
            </button>
            <button onclick="openScannerModal()" title="مسح كيو آر الحضور" class="bg-indigo-600 hover:bg-indigo-700 text-white px-3 py-2 rounded-xl text-sm transition flex items-center space-x-1 space-x-reverse shadow-md">
              <i class="fa-solid fa-camera"></i>
              <span class="hidden sm:inline">مسح بالكاميرا</span>
            </button>
            <button onclick="openAddStudentModal()" class="gold-gradient text-slate-900 px-4 py-2 rounded-xl font-bold text-sm hover:opacity-90 transition flex items-center space-x-2 space-x-reverse">
              <i class="fa-solid fa-plus"></i>
              <span>إضافة طالب</span>
            </button>
          </div>
        </div>
      </header>

      <!-- Main Content Container -->
      <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 flex-grow w-full space-y-6">
        
        <!-- Grades Tabs Selector -->
        <div class="flex items-center space-x-2 space-x-reverse overflow-x-auto pb-2 border-b border-slate-800">
          <button onclick="selectGrade('1_prep')" id="tab_1_prep" class="grade-tab px-4 py-2 rounded-xl text-sm font-bold whitespace-nowrap transition bg-slate-800 text-slate-300 hover:bg-slate-700">الأول الإعدادي</button>
          <button onclick="selectGrade('2_prep')" id="tab_2_prep" class="grade-tab px-4 py-2 rounded-xl text-sm font-bold whitespace-nowrap transition bg-slate-800 text-slate-300 hover:bg-slate-700">الثاني الإعدادي</button>
          <button onclick="selectGrade('3_prep')" id="tab_3_prep" class="grade-tab px-4 py-2 rounded-xl text-sm font-bold whitespace-nowrap transition bg-slate-800 text-slate-300 hover:bg-slate-700">الثالث الإعدادي</button>
          <button onclick="selectGrade('1_sec')" id="tab_1_sec" class="grade-tab px-4 py-2 rounded-xl text-sm font-bold whitespace-nowrap transition bg-slate-800 text-slate-300 hover:bg-slate-700">الأول الثانوي</button>
          <button onclick="selectGrade('2_sec')" id="tab_2_sec" class="grade-tab px-4 py-2 rounded-xl text-sm font-bold whitespace-nowrap transition bg-slate-800 text-slate-300 hover:bg-slate-700">الثاني الثانوي</button>
          <button onclick="selectGrade('bac')" id="tab_bac" class="grade-tab px-4 py-2 rounded-xl text-sm font-bold whitespace-nowrap transition bg-slate-800 text-slate-300 hover:bg-slate-700">صف البكالوريا</button>
        </div>

        <!-- Financial Summary Banner -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="card-bg p-4 rounded-2xl border-r-4 border-amber-500 flex items-center justify-between">
            <div>
              <span class="text-xs text-slate-400 block font-medium">مجموع مدفوعات الصف الحالي</span>
              <span id="gradeTotalAmount" class="text-xl font-bold text-amber-400">0 ج.م</span>
            </div>
            <i class="fa-solid fa-wallet text-2xl text-slate-700"></i>
          </div>

          <div class="card-bg p-4 rounded-2xl border-r-4 border-emerald-500 flex items-center justify-between">
            <div>
              <span class="text-xs text-slate-400 block font-medium">إجمالي تحصيل كل الصفوف</span>
              <span id="allGradesTotalAmount" class="text-xl font-bold text-emerald-400">0 ج.م</span>
            </div>
            <i class="fa-solid fa-coins text-2xl text-slate-700"></i>
          </div>
        </div>

        <!-- Controls Bar -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <div class="md:col-span-2 relative">
            <span class="absolute inset-y-0 right-0 flex items-center pr-3 text-slate-400">
              <i class="fa-solid fa-magnifying-glass"></i>
            </span>
            <input type="text" id="searchInput" oninput="renderStudents()" placeholder="ابحث باسم الطالب أو بالكود..." class="w-full pr-10 pl-4 py-3 rounded-xl input-style text-sm">
          </div>

          <button onclick="openReportModal()" class="bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-3 px-4 rounded-xl text-sm transition flex items-center justify-center space-x-2 space-x-reverse shadow-lg">
            <i class="fa-solid fa-chart-pie"></i>
            <span>تقرير آخر الشهر والشهور المستحقة</span>
          </button>
        </div>

        <!-- Students List Header -->
        <div class="flex items-center justify-between">
          <h3 class="text-lg font-bold text-slate-200 flex items-center space-x-2 space-x-reverse">
            <span id="currentGradeTitle">الأول الإعدادي</span>
            <span id="studentCountBadge" class="bg-slate-800 text-amber-400 text-xs px-2.5 py-1 rounded-full border border-slate-700">0 طالب</span>
          </h3>
        </div>

        <!-- Students Cards Grid -->
        <div id="studentsGrid" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3"></div>

        <!-- Empty State -->
        <div id="emptyState" class="hidden text-center py-12 card-bg rounded-2xl">
          <i class="fa-solid fa-user-slash text-4xl text-slate-600 mb-3"></i>
          <p class="text-slate-400 text-sm">لا يوجد طلاب مسجلين في هذا الصف حتى الآن.</p>
        </div>
      </main>
    </div>
  </div>

  <footer class="py-4 border-t border-slate-800 text-center text-xs text-slate-400 tracking-wider">
    Created by Omar Hadwa | الدعم الفني 01013587867
  </footer>

  <!-- Modal: Treasury / Daily Revenue (دفتر الخزينة اليومية) -->
  <div id="treasuryModal" class="fixed inset-0 bg-black/75 backdrop-blur-sm flex items-center justify-center p-4 z-50 hidden">
    <div class="card-bg rounded-2xl max-w-xl w-full p-6 space-y-4 border border-slate-700 shadow-2xl max-h-[90vh] flex flex-col">
      <div class="flex items-center justify-between border-b border-slate-700 pb-3 flex-shrink-0">
        <h3 class="font-bold text-slate-100 flex items-center gap-2">
          <i class="fa-solid fa-vault text-amber-400"></i> دفتر الخزينة والإيرادات اليومية
        </h3>
        <button onclick="closeTreasuryModal()" class="text-slate-400 hover:text-white"><i class="fa-solid fa-xmark text-lg"></i></button>
      </div>

      <div class="bg-slate-900/70 p-4 rounded-xl border border-slate-800 flex items-center justify-between flex-shrink-0">
        <div>
          <span class="text-xs text-slate-400 block font-medium">إجمالي الإيرادات المسجلة</span>
          <span id="totalTreasurySum" class="text-xl font-bold text-emerald-400">0 ج.م</span>
        </div>
        <i class="fa-solid fa-sack-dollar text-3xl text-slate-700"></i>
      </div>

      <!-- نموذج تسجيل إيراد يوم جديد -->
      <form onsubmit="handleTreasurySubmit(event)" class="grid grid-cols-1 sm:grid-cols-3 gap-2 flex-shrink-0">
        <div>
          <label class="block text-[11px] text-slate-400 mb-1">التاريخ</label>
          <input type="date" id="treasuryDate" required class="w-full p-2 rounded-xl input-style text-xs">
        </div>
        <div>
          <label class="block text-[11px] text-slate-400 mb-1">المبلغ المدخل (ج.م)</label>
          <input type="number" id="treasuryAmount" required placeholder="مثال: 500" class="w-full p-2 rounded-xl input-style text-xs font-bold text-emerald-400">
        </div>
        <div class="flex items-end">
          <button type="submit" class="w-full py-2 bg-emerald-600 hover:bg-emerald-500 text-white font-bold rounded-xl text-xs transition shadow">
            تسجيل إيراد اليوم
          </button>
        </div>
      </form>

      <!-- سجل الأيام -->
      <div class="flex-grow overflow-y-auto space-y-2 pr-1 pt-2">
        <h4 class="font-bold text-xs text-slate-300">سجل إيرادات الأيام السابقة</h4>
        <div id="treasuryRecordsList" class="space-y-1.5"></div>
      </div>
    </div>
  </div>

  <!-- Modal: Teacher Settings (تعديل بيانات المعلم والباسورد) -->
  <div id="teacherSettingsModal" class="fixed inset-0 bg-black/75 backdrop-blur-sm flex items-center justify-center p-4 z-50 hidden">
    <div class="card-bg rounded-2xl max-w-md w-full p-6 space-y-4 border border-slate-700 shadow-2xl">
      <div class="flex items-center justify-between border-b border-slate-700 pb-3">
        <h3 class="font-bold text-slate-100 flex items-center gap-2">
          <i class="fa-solid fa-user-gear text-indigo-400"></i> إعدادات حساب المعلم
        </h3>
        <button onclick="closeTeacherSettingsModal()" class="text-slate-400 hover:text-white"><i class="fa-solid fa-xmark text-lg"></i></button>
      </div>

      <form onsubmit="handleTeacherSettingsSave(event)" class="space-y-3">
        <div>
          <label class="block text-xs font-medium text-slate-300 mb-1">اسم المنصة / المعلم</label>
          <input type="text" id="settingTeacherName" required class="w-full p-2.5 rounded-xl input-style text-sm" placeholder="MR">
        </div>
        <div>
          <label class="block text-xs font-medium text-slate-300 mb-1">بريد تسجيل الدخول الجديد</label>
          <input type="text" id="settingTeacherEmail" required class="w-full p-2.5 rounded-xl input-style text-sm" placeholder="mr@gmail.com">
        </div>
        <div>
          <label class="block text-xs font-medium text-slate-300 mb-1">كلمة المرور الجديدة</label>
          <input type="text" id="settingTeacherPassword" required class="w-full p-2.5 rounded-xl input-style text-sm" placeholder="••••••••">
        </div>

        <div class="pt-2 flex justify-end space-x-2 space-x-reverse">
          <button type="button" onclick="closeTeacherSettingsModal()" class="px-4 py-2 bg-slate-800 text-slate-300 text-xs font-bold rounded-xl hover:bg-slate-700">إلغاء</button>
          <button type="submit" class="px-5 py-2 gold-gradient text-slate-900 text-xs font-bold rounded-xl hover:opacity-90">حفظ التعديلات</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Modal: Print Center (مركز طباعة كشف الطلاب) -->
  <div id="printCenterModal" class="fixed inset-0 bg-black/85 backdrop-blur-md flex items-center justify-center p-4 z-50 hidden">
